{
  "name": "TasmoClaw mbedTLS SSL shim",
  "version": "0.1.0",
  "build": {
    "libArchive": false,
    "flags": [
      "-I$PROJECT_DIR/lib/libesp32/tasmoclaw_mbedtls_ssl/library",
      "-DCONFIG_MBEDTLS_TLS_ENABLED=1",
      "-DCONFIG_MBEDTLS_TLS_CLIENT=1",
      "-DCONFIG_MBEDTLS_TLS_CLIENT_ONLY=1",
      "-DCONFIG_MBEDTLS_SSL_PROTO_TLS1_2=1",
      "-DCONFIG_MBEDTLS_KEY_EXCHANGE_RSA=1",
      "-DCONFIG_MBEDTLS_KEY_EXCHANGE_ECDHE_RSA=1",
      "-DCONFIG_MBEDTLS_KEY_EXCHANGE_ECDHE_ECDSA=1",
      "-DCONFIG_MBEDTLS_AES_C=1",
      "-DCONFIG_MBEDTLS_GCM_C=1",
      "-DCONFIG_MBEDTLS_CIPHER_C=1",
      "-DCONFIG_MBEDTLS_CIPHER_MODE_CBC=1",
      "-DCONFIG_MBEDTLS_CIPHER_MODE_CTR=1",
      "-DCONFIG_MBEDTLS_ECP_DP_SECP256R1_ENABLED=1"
    ]
  }
}
